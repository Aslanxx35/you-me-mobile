{
  "expo": {
    "owner": "aslanxxs-team",
    "name": "YOU me",
    "slug": "z-zenith",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zenith",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#060610"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zenith.app",
      "associatedDomains": ["applinks:zenith.app"],
      "infoPlist": {
        "NSFaceIDUsageDescription": "Premium ve hesabınız için biyometrik doğrulama kullanılır.",
        "NSCameraUsageDescription": "Paylaşılabilir astroloji görselleri oluşturmak için kamera erişimi gerekir.",
        "NSPhotoLibraryUsageDescription": "Paylaşılabilir astroloji görsellerini kaydetmek için fotoğraf erişimi gerekir.",
        "NSUserTrackingUsageDescription": "Kişiselleştirilmiş ürün analitiği için kullanım verileri işlenebilir."
      }
    },
    "android": {
      "package": "com.zenith.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060610"
      },
      "permissions": ["POST_NOTIFICATIONS", "CAMERA", "READ_MEDIA_IMAGES", "USE_BIOMETRIC"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "zenith.app", "pathPrefix": "/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      "expo-secure-store",
      "expo-local-authentication",
      "@sentry/react-native/expo"
    ],
    "extra": {
      "eas": { "projectId": "69524cbe-3d59-4c1d-9f6a-80e945202172" },
      "router": { "origin": false }
    }
  }
}
